<?xml version = "1.0" encoding = "UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiDemo2.ViewModel"
             xmlns:models="clr-namespace:MauiDemo2.Models"
             xmlns:converters="clr-namespace:MauiDemo2.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiDemo2.Views.CardPage"
             x:DataType="viewmodels:CardViewModel"
             BackgroundColor="#FFFCF1"
             Padding="15">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:RatingToStarsConverter x:Key="RatingToStarsConverter"/>
            <converters:FavoriteToHeartConverter x:Key="FavoriteToHeartConverter"/>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Inter-Regular" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Inter-Regular" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*, Auto"
                  ColumnSpacing ="20"
                  HeightRequest="38"
                  Margin="20,0,20,10">
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="White"
                        Grid.Column="0">
                    <Image Source="glass.svg"
                           HeightRequest="22"
                           WidthRequest="22"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           Margin="10"/>
                    <Border.Shadow>
                        <Shadow Brush="#343330" 
                                Opacity="0.4" 
                                Offset="0,4" 
                                Radius="6" />
                    </Border.Shadow>
                </Border>
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        WidthRequest="38"
                        HorizontalOptions="End"
                        BackgroundColor="White"
                        Grid.Column="1">
                    <Image Source="sliders.svg"
                           HeightRequest="26"
                           WidthRequest="26"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Margin="10"/>
                    <Border.Shadow>
                        <Shadow Brush="#343330" 
                                Opacity="0.4" 
                                Offset="0,4" 
                                Radius="6" />
                    </Border.Shadow>
                </Border>
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Routes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:RouteMainPage">
                        <VerticalStackLayout>
                            <Grid  ColumnDefinitions="*, Auto"
                                   ColumnSpacing="20"
                                   Margin="20,0,0,10">
                                <HorizontalStackLayout Spacing="10">
                                    <Border StrokeShape="Ellipse"
                                            StrokeThickness="0"
                                            BackgroundColor="White"
                                            HeightRequest="45"
                                            WidthRequest="45"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Image Source="glass.svg"
                                               HeightRequest="22"
                                               WidthRequest="22"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Margin="10"/>
                                        <Border.Shadow>
                                            <Shadow Brush="#343330"
                                                    Opacity="0.4"
                                                    Offset="0,4"
                                                    Radius="6" />
                                        </Border.Shadow>
                                    </Border>
                                    <Label Text="Wilson Press"
                                           FontSize="14"
                                           TextColor="Black"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="3 дня назад"
                                       FontSize="13"
                                       TextColor="Black"
                                       VerticalOptions="End"
                                       HorizontalOptions="End"/>
                            </Grid>
                            <Border StrokeShape="RoundRectangle 25"
                                        StrokeThickness="0"
                                        BackgroundColor="#F9D6B8"
                                        Padding="0"
                                        Margin="20, 0, 20 , 30">
                                <Border.Shadow>
                                    <Shadow Brush="#343330" 
                                                Opacity="0.4" 
                                                Offset="0,4" 
                                                Radius="6" />
                                </Border.Shadow>
                                <Grid RowDefinitions="200, Auto, Auto, Auto"
                                            RowSpacing="5"
                                            HorizontalOptions="FillAndExpand">
                                    <CarouselView ItemsSource="{Binding Images}"
                                                        Grid.Row="0">
                                        <CarouselView.ItemTemplate>
                                            <DataTemplate>
                                                <Border StrokeThickness="0"
                                                            Padding="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="0,0,20,20"/>
                                                    </Border.StrokeShape>
                                                    <Image Source="{Binding .}"
                                                               Aspect="AspectFill"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="FillAndExpand"/>
                                                </Border>
                                            </DataTemplate>
                                        </CarouselView.ItemTemplate>
                                    </CarouselView>
                                    <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               TextColor="Black"
                                               VerticalOptions="Start"
                                               HorizontalOptions="Start"
                                               Margin="20,15,0,0"/>
                                    <Image Grid.Row="0"
                                               Grid.Column="1"
                                               Source="{Binding IsFavorite, Converter={StaticResource FavoriteToHeartConverter}}"
                                               WidthRequest="30"
                                               HeightRequest="30"
                                               VerticalOptions="Start"
                                               HorizontalOptions="End"
                                               Margin="0,15,20,0"/>
                                    <VerticalStackLayout Grid.Row="0"
                                                             Grid.Column="0"
                                                             VerticalOptions="End"
                                                             HorizontalOptions="Start"
                                                             Margin="20,0,0,20"
                                                             Spacing="2">
                                        <HorizontalStackLayout Spacing="5">
                                            <Image Source="trip.svg"
                                                       HeightRequest="23"
                                                       WidthRequest="23"
                                                       VerticalOptions="Center">
                                                <Image.Behaviors>
                                                    <toolkit:IconTintColorBehavior TintColor="#343330" />
                                                </Image.Behaviors>
                                            </Image>
                                            <Label Text="{Binding Distance, StringFormat='{}{0} km'}"
                                                       FontSize="15"
                                                       TextColor="Black"
                                                       VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="5">
                                            <Image Source="run.svg"
                                                       HeightRequest="17"
                                                       WidthRequest="17"
                                                       VerticalOptions="Center"/>
                                            <Label Text="{Binding TimesCompleted}"  
                                                       FontSize="11"
                                                       TextColor="Black"
                                                       VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="5">
                                            <HorizontalStackLayout Spacing="5" HorizontalOptions="Start" BindableLayout.ItemsSource="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding .}" WidthRequest="14" HeightRequest="15" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Rating}"
                                                        FontSize="12"
                                                        TextColor="Black"
                                                        VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <IndicatorView Grid.Row="1"
                                                       x:Name="TextIndicator"
                                                       IndicatorColor="#FDA895"
                                                       SelectedIndicatorColor="#F17256"
                                                       HorizontalOptions="Center"
                                                       IndicatorSize="7"/>
                                    <CarouselView Grid.Row="2"
                                                      ItemsSource="{Binding DescriptionParts}"
                                                      HorizontalOptions="FillAndExpand"
                                                      IsBounceEnabled="False"
                                                      PeekAreaInsets="0"
                                                      Margin="15,0,15,10"
                                                      Loop="False"
                                                      IndicatorView="{x:Reference TextIndicator}">
                                        <CarouselView.ItemTemplate>
                                            <DataTemplate>
                                                <Label Text="{Binding .}"
                                                             FontSize="10"
                                                             HorizontalOptions="FillAndExpand"
                                                             VerticalOptions="FillAndExpand"
                                                             TextColor="Black"
                                                             LineBreakMode="WordWrap"/>
                                            </DataTemplate>
                                        </CarouselView.ItemTemplate>
                                    </CarouselView>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
