<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiDemo2.ViewModel"
             xmlns:models="clr-namespace:MauiDemo2.Models"
             x:Class="MauiDemo2.Views.CardPage"
             x:DataType="viewmodels:CardViewModel"
             Padding="15">
    <ScrollView>
        <VerticalStackLayout Spacing="10">
            <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    BackgroundColor="Goldenrod"
                    VerticalOptions="Start"
                    Padding="15">
                <Grid ColumnDefinitions="*, 150"
                      RowDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Row="0"
                                         Grid.Column="0"
                                         Spacing="10">
                        <Label Text="Best offer"
                               FontSize="25"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Text="Grab thuis amazing offer before it expires"/>

                    </VerticalStackLayout>
                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Text="Get it now"
                            BackgroundColor="PaleGoldenrod"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="22"
                            HorizontalOptions="Start"
                            Padding="25, 0"/>
                    <Image Grid.RowSpan="2"
                           Grid.Column="1"
                           Source="heart.jpg"
                           HeightRequest="150"
                           WidthRequest="150"/>
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="2"
                    Stroke="Goldenrod">
                <Label Text="Search here..."
                       TextColor="Goldenrod"
                       FontSize="15"
                       Padding="10, 14"/>
            </Border>

            <Grid ColumnDefinitions="*,*">
                <Label Grid.Column="0"
                       Text="Popular items"
                       VerticalOptions="End"
                       FontSize="20"
                       FontAttributes="Bold"/>
                <Label Grid.Column="1"
                       Text="View all"
                       HorizontalOptions="End"
                       VerticalOptions="End" 
                       TextDecorations="Underline"/>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Routes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:RouteMainPage">
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                BackgroundColor="PaleGoldenrod"
                                Padding="0"
                                Margin="20,10">
                            <Grid RowDefinitions="200, Auto, Auto, Auto"
                                  RowSpacing="5"
                                  HorizontalOptions="FillAndExpand">
                                <CarouselView ItemsSource="{Binding Images}"
                                              Grid.Row="0">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="0"
                                                    Padding="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="0,0,20,20"/>
                                                </Border.StrokeShape>
                                                <Image Source="{Binding .}"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="FillAndExpand"
                                                       VerticalOptions="FillAndExpand"/>
                                            </Border>
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Start"
                                       HorizontalOptions="Start"
                                       Margin="10,10,0,0"/>
                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding IsFavorite}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Start"
                                       HorizontalOptions="End"
                                       Margin="0,10,10,0"/>
                                <VerticalStackLayout Grid.Row="0"
                                                     Grid.Column="0"
                                                     VerticalOptions="End"
                                                     HorizontalOptions="Start"
                                                     Margin="10,0,0,10"
                                                     Spacing="5">
                                    <Label Text="{Binding TimesCompleted}"
                                           FontSize="14"
                                           TextColor="White"/>
                                    <Label Text="{Binding Rating}"
                                           FontSize="14"
                                           TextColor="White"/>
                                    <Label Text="{Binding Distance}"
                                           FontSize="14"
                                           TextColor="White"/>
                                </VerticalStackLayout>
                                <IndicatorView Grid.Row="1"
                                                x:Name="TextIndicator"
                                                IndicatorColor="Gray"
                                                SelectedIndicatorColor="Goldenrod"
                                                HorizontalOptions="Center"
                                               IndicatorSize="7"/>
                                <CarouselView Grid.Row="2"
                                              ItemsSource="{Binding DescriptionParts}"
                                              HorizontalOptions="FillAndExpand"
                                              IsBounceEnabled="False"
                                              PeekAreaInsets="0"
                                              Margin="15,0,15,0"
                                              Loop="False"
                                              IndicatorView="{x:Reference TextIndicator}">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}"
                                                   FontSize="12"
                                                   HorizontalOptions="FillAndExpand"
                                                   VerticalOptions="FillAndExpand"
                                                   TextColor="Black"
                                                   LineBreakMode="WordWrap"/>
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
