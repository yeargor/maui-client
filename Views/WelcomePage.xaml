<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiDemo2.Views.WelcomePage"
             xmlns:vm="clr-namespace:MauiDemo2.ViewModels"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <ContentPage.BindingContext>
        <vm:WelcomePageViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="*,Auto">
        <Grid Padding="0,0,0,-40">
            <Image Source="welcome.png"
               Aspect="AspectFill"
               Grid.Row="0"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand"/>
        </Grid>
        <Border Grid.Row="1"
                BackgroundColor="White"
                HeightRequest="200"
                VerticalOptions="End"
                StrokeThickness="0">
                <Grid RowDefinitions="Auto,Auto,Auto" VerticalOptions="Center" Padding="30,20,30,20">
                    <Label Text="Исследуйте родные просторы вместе!"
                                FontSize="21"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="#3C2222"/>
                    <Button Text="Зарегистрироваться"
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            Padding="20,0,20,0"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="18"
                            BackgroundColor="#F17256"
                            TextColor="White"
                            HorizontalOptions="Center"
                            Command="{Binding ToRegisterPageCommand}"/>
                    <Label Grid.Row="2" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Войти в аккаунт"
                                      TextColor="#F17256"
                                      FontSize="15"
                                      TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToLoginPageCommand}"/>
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="40,0,0,0" />
            </Border.StrokeShape>
        </Border>
    </Grid>
</ContentPage>
