<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MauiDemo2.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MauiDemo2"
       xmlns:views="clr-namespace:MauiDemo2.Views"
       Shell.FlyoutBehavior="Disabled">

    <TabBar x:Name="MainTabBar"
        Shell.TabBarForegroundColor="#F17256"
        Shell.TabBarUnselectedColor="#BA9B95">
        <Tab Icon="house.svg">
            <ShellContent
                   Icon="house.svg"
                   ContentTemplate="{DataTemplate views:CardPage}"/>
        </Tab>
        <Tab Icon="user.svg">
            <ShellContent Icon="user.svg"
                          ContentTemplate="{DataTemplate views:ProfilePage}"/>
        </Tab>
        <Tab Icon="map.svg">
            <ShellContent Icon="map.svg"
                   ContentTemplate="{DataTemplate views:FollowingPage}"/>
        </Tab>
    </TabBar>
</Shell>
